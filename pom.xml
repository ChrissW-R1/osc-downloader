<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>me.chrisswr1</groupId>
		<artifactId>java-parent</artifactId>
		<version>2.3.1</version>
	</parent>

	<!-- project identifier -->
	<artifactId>osc-downloader</artifactId>
	<version>0.1.0-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>OSC Downloader</name>
	<url>https://github.com/ChrissW-R1/osc-downloader</url>
	<description>
		service to download permanently OpenStreetMap changes
	</description>
	<inceptionYear>2025</inceptionYear>

	<organization>
		<name>ChrissW-R1</name>
		<url>http://ChrissW-R1.me</url>
	</organization>

	<properties>
		<project.module-root.artifactId>osc-downloader</project.module-root.artifactId>
		<project.module-root.relativedir>./</project.module-root.relativedir>
	</properties>

	<scm>
		<url>https://github.com/${project.organization.name}/${project.module-root.artifactId}</url>
		<connection>scm:git:${project.scm.url}.git</connection>
		<developerConnection>${project.scm.connection}</developerConnection>
		<tag>HEAD</tag>
	</scm>

	<distributionManagement>
		<repository>
			<id>project-repo</id>
			<name>Project Repository</name>
			<url>https://maven.pkg.github.com/${project.organization.name}/${project.module-root.artifactId}</url>
		</repository>
		<site>
			<id>project-site-repo</id>
			<name>Project's Site - Repository</name>
			<url>${project.site.deploy.url}</url>
		</site>
	</distributionManagement>

	<repositories>
		<repository>
			<id>general-parent</id>
			<name>General Parent</name>
			<url>https://maven.pkg.github.com/ChrissW-R1/general-parent</url>
		</repository>
	</repositories>
</project>
